{
  "name": "keel-payroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4477",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4477",
    "lint": "eslint",
    "test": "tsx --test test/*.test.ts",
    "test:all": "npm test && forge test",
    "test:forge": "forge test",
    "test:fork": "CELO_FORK_RPC=${CELO_FORK_RPC:-https://forno.celo.org} forge test --match-contract PayrollGuardFork",
    "fork-demo": "tsx scripts/fork-demo.ts",
    "anvil": "anvil --fork-url https://forno.celo.org --port 18545",
    "register:8004": "tsx scripts/register-8004.ts",
    "session:grant": "tsx scripts/session-grant.ts",
    "session:grant:send": "tsx scripts/session-grant-send.ts",
    "session:revoke": "tsx scripts/session-revoke.ts",
    "smoke": "tsx scripts/smoke-tagged-tx.ts",
    "settle": "tsx scripts/settle-payout.ts",
    "kane": "node scripts/kane-gate.mjs",
    "kane:smoke": "node scripts/kane-gate.mjs --tags smoke",
    "kane:changed": "node scripts/kane-gate.mjs --changed",
    "kane:design": "kane-cli context add kane/requirements && kane-cli context find && kane-cli design",
    "build:desk-worker": "node desk-worker/build.mjs",
    "deploy:desk": "node scripts/kane-deploy.mjs desk",
    "deploy:jobs": "node scripts/kane-deploy.mjs jobs"
  },
  "dependencies": {
    "@altananetwork/sdk": "^1.1.0",
    "@base-ui/react": "^1.9.0",
    "@celo/attribution-tags": "^0.5.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.58.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
