# Public demo. Leave these unset on Vercel.
KEEL_MODE=mock
KEEL_ALLOW_LIVE=

# Optional intent parser. The rule parser runs when this is empty.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Reads. The public RPC needs no key.
CELO_RPC_URL=https://forno.celo.org
ANVIL_RPC_URL=http://127.0.0.1:18545
# Opt-in Celo mainnet fork tests (`npm run test:fork`). Unset = `forge test` skips them and stays offline.
CELO_FORK_RPC=

# Never commit real keys. Scripts refuse non-loopback RPCs unless you also set
# I_UNDERSTAND_MAINNET=1 on your own machine.
AGENT_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
SESSION_SIGNER_PRIVATE_KEY=
SESSION_FILE=
PAYROLL_GUARD_ADDRESS=
PAYEE_ADDRESS=
PAYEE_COUNTRY=Brazil
PAYOUT_USD=1.00

# Optional. Skips Textile takerProof. Create one in the Textile app. Do not put it in the client.
TEXTILE_API_KEY=

# Issued hackathon code. Do not change it if you want the entry credited.
ATTRIBUTION_CODE=celo_5bf71df0ebf6

# Used in the ERC-8004 registration file. No trailing path.
AGENT_PUBLIC_URL=http://127.0.0.1:4477

# Must both be 1 before any script broadcasts off localhost.
SEND=
I_UNDERSTAND_MAINNET=
